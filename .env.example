# Copy to backend/.env and adjust. All values are optional in development.

# --- Django ---
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Extra CSRF-trusted origins (the CORS origins below are always included):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com

# --- Database ---
# Leave unset to use SQLite (backend/db.sqlite3).
# Use a dedicated Supabase project for Vault; do not share another Django app's database.
# In Supabase, select Connect -> Direct Connection -> Method: Session Pooler,
# then copy the URI. Keep its host, username, and port exactly as provided.
# Replace [YOUR-PASSWORD] locally; URL-encode special characters in the password.
# For Plesk production values, start from .env.plesk.example instead.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres
# DATABASE_SSL_REQUIRE=1
# DATABASE_CONN_MAX_AGE=60

# --- Access workflow ---
# The owner account (hasshamahmed73@gmail.com) is set in config/settings.py
# (GHOST_OWNER_EMAIL): always approved and admin, can never be rejected or deleted.

# --- Frontend / CORS ---
# Where you open the site; used for password-reset links (`npm start` serves on 3000).
FRONTEND_URL=http://localhost:8080
# Frontend origins allowed to call the API. Defaults to localhost / 127.0.0.1 on
# ports 3000, 5173 and 8080, which are always allowed while DJANGO_DEBUG=1.
# In production set your real frontend origin(s):
# CORS_ALLOWED_ORIGINS=https://ghost.example.com

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Email (console backend prints emails to the server log) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=GHOST <no-reply@example.com>
